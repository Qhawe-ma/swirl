# Server
PORT=5000

# Firebase web config. The server reads these and serves them at /api/firebase-config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Pinata JWT used by the browser to pin image and metadata. Without it, uploads
# fall back to a placeholder image.
VITE_PINATA_JWT=

# Solana. Leave blank to use the public mainnet RPC.
VITE_HELIUS_RPC_URL=
VITE_SOLANA_RPC_URL=
VITE_PROJECTSERUM_RPC_URL=

# Optional. Defaults live in client/src/lib/solana.ts (0.01 SOL, built-in fee account).
VITE_PLATFORM_FEE_SOL=
VITE_PLATFORM_FEE_ADDRESS=
